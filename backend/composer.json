{
    "name": "buldov/pickleball-backend",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.4.0" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit tests",
        "migrate": "php bin/migrate.php",
        "serve": "php -S localhost:8080 public/index.php"
    }
}
