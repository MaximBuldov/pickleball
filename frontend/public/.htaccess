RewriteEngine On

# Force HTTPS — enable once the subdomain has an SSL certificate
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API is handled by api/.htaccess
RewriteRule ^api(/|$) - [L]

# Existing files are served as-is; everything else is a React route
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    # Hashed build assets never change; the shell and service worker must always be fresh
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|registerSW\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
